{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run turbo run build --filter=operations...",
    "watchPatterns": [
      "/apps/operations/**",
      "/packages/**",
      "/docs/runbooks/operations/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/railway/operations-web.json"
    ]
  },
  "deploy": {
    "startCommand": "bun --cwd apps/operations start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
