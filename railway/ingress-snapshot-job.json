{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/services/jetstream-ingest/Dockerfile",
    "watchPatterns": [
      "/services/jetstream-ingest/**",
      "/database/migrations/**",
      "/railway/ingress-snapshot-job.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
