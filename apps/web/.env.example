# Copy to .env.local and adjust. No secrets are required for local ATProto OAuth loopback.
# See apps/web/README.md for behaviour details.

# Banner + OAuth mode: prod | dev | local (unset in next dev → local banner + loopback OAuth).
# Prefer NEXT_PUBLIC_* so the client bundle sees it; APP_ENV alone is forwarded at build via next.config.
# NEXT_PUBLIC_APP_ENV=dev
# APP_ENV=dev

# Optional override for a nonstandard hosted OAuth deployment. Railway Development
# and Production use same-origin /oauth-client-metadata.json by default.
# Keep client_id, redirect_uris, the Web custom domain, and Gateway OAUTH_PUBLIC_ORIGIN aligned.
# NEXT_PUBLIC_ATPROTO_CLIENT_ID=https://thesocialwire.app/oauth-client-metadata.json

# NEXT_PUBLIC_ATPROTO_LOOPBACK_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_ATPROTO_LOOPBACK_CALLBACK_PATH=/callback
# NEXT_PUBLIC_ATPROTO_LOOPBACK_FORCE=false

# Thin AppView derived read index on the Social Wire gateway.
# Enabled by default; set false only when diagnosing a deployment without AppView routes.
# NEXT_PUBLIC_USE_THIN_APPVIEW=true
# Railway Development: https://api.testing.thesocialwire.app
# Railway Production:  https://api.thesocialwire.app
# NEXT_PUBLIC_SOCIALWIRE_API_URL=https://api.thesocialwire.app

# Canonical Web origin used for metadata and absolute social-card URLs.
# Railway Development: https://testing.thesocialwire.app
# Railway Production:  https://thesocialwire.app
# NEXT_PUBLIC_SITE_URL=https://thesocialwire.app

# Local UI annotation mode — bypasses OAuth/Gateway and renders canned reader data.
# NEXT_PUBLIC_USE_DUMMY_DATA=false
# NEXT_PUBLIC_WIRE_NEWS_EDITION_ENABLED=false

# L@tr / LatrKit gateway (read-later save/archive/delete mutations; default provider)
# Browser calls same-origin /api/latr-gateway/*; server injects credentials below.
# Optional upstream override (server reads LATR_GATEWAY_URL, then NEXT_PUBLIC_LATR_GATEWAY_URL):
# LATR_GATEWAY_URL=http://127.0.0.1:8080
# Hosted test/dev upstream default: https://api.testing.latr.link
# Hosted prod upstream default: https://api.latr.link
# Server-only credentials (do not use NEXT_PUBLIC_* for secrets):
# Prefer the official credential issued for the active api.*.latr.link gateway:
# LATR_GATEWAY_CLIENT_CREDENTIAL=the-social-wire-web=BASE64…
# Or bare base64 after `=` is parsed automatically. Official wins if split vars are also set.
# Split developer keys (must be issued for the same gateway host; remove if using official):
# LATR_GATEWAY_CLIENT_ID=the-social-wire-web
# LATR_GATEWAY_API_KEY=lk_...
# Full official credential map (optional; extracts the-social-wire-web entry):
# LATR_GATEWAY_OFFICIAL_CLIENT_CREDENTIALS=the-social-wire-web=BASE64…,latr-link-web=…
# Non-prod debug: GET /api/latr-gateway/debug/credentials (probe.ok=true means app cred accepted).
# On 403, check response JSON `error` or X-Latr-Upstream-Error header after deploy.
# NEXT_PUBLIC_LATR_READ_LATER_PROVIDER=latr-gateway
# Set to pds-direct only for legacy/debug direct PDS writes.
