meta {
  name: POST Podcast clips/publish
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/podcasts/clips/publish
  body: json
  auth: none
}

body:json {
{
  "clipId": "{{podcastClipId}}",
  "uri": "{{podcastClipUri}}"
}
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
}
