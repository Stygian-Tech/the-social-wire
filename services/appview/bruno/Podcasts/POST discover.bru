meta {
  name: POST Podcast Index Discover
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/v1/podcasts/search
  body: json
  auth: none
}

body:json {
{
  "query": "technology",
  "scope": "directory",
  "limit": 50
}
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
}
