meta {
  name: XRPC app.thesocialwire.socialDraft.uploadAttachment
  type: http
  seq: 91
}

post {
  url: {{baseUrl}}/xrpc/app.thesocialwire.socialDraft.uploadAttachment
  body: file
  auth: none
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  Content-Type: application/octet-stream
  X-Social-Draft-Upload-Id: {{draftAssetId}}
  Content-Length: {{draftAssetByteLength}}
}

body:file {
  file: {{draftAssetFilePath}}
}

docs {
  Private owner-only attachment storage. Never publishes or returns a public URL.
  Disabled by default (503). Upload requires a known byte length from 1 to 104857600.
  Downloads return original Content-Type with Cache-Control: private, no-store.
}
