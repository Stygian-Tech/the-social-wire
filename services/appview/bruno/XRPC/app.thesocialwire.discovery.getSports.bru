meta {
  name: XRPC app.thesocialwire.discovery.getSports
  type: http
  seq: 60
}

get {
  url: {{baseUrl}}/xrpc/app.thesocialwire.discovery.getSports?feed=sports&limit=30&lang=en&refreshSelections=true
  body: none
  auth: none
}

headers {
  X-SocialWire-Gateway-DID: {{gatewayViewerDid}}
  X-SocialWire-Gateway-Timestamp: {{gatewayTimestamp}}
  X-SocialWire-Gateway-Signature: {{gatewaySignature}}
}

docs {
  Set feed to a getSportsCatalog ID (for example industry:technology or group:mag7).
  Named feeds return matching stories only; cursors cannot cross feeds.
  Finance V1: instrument interests are public PDS records, while article serving
  applies current moderation and generation-bound continuation. Catalog and
  widgets remain disabled until rollout evidence gates are approved.
}
