# The Social Wire Gateway environment
#
# Configure hosted values as Railway service variables. Keep this file as
# documentation only; do not commit real credentials.

# Runtime mode. The current process entry point accepts only `dev` or `prod`.
# A SQLite backend remains implemented but is unreachable until the shared
# Operations environment guard supports `local`.
APP_ENV=dev

# Railway injects `PORT`. Binding to `::` accepts Railway private-network IPv6
# traffic as well as IPv4 traffic.
PORT=8080
BIND_HOST=::

# Optional dotenv file path for local/manual runs. Process and Railway variables
# override file values.
DOTENV_PATH=.env

# Required when APP_ENV is `dev` or `prod`.
# Reference the Railway Postgres service's private connection URL.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Keep this low because gateway, appview, worker, and operations share the
# Railway Postgres service's connection budget.
POSTGRES_MAX_CONNECTIONS=2

# Optional override for ATProto PLC discovery.
ATPROTO_PLC_URL=https://plc.directory

# AppView proxy target. Required for the gateway to serve /v1/appview/* and
# /v1/publications/* from the distributed AppView service.
APPVIEW_BASE_URL=http://${{App View.RAILWAY_PRIVATE_DOMAIN}}:${{App View.PORT}}

# Shared HMAC secret for Gateway -> AppView internal trust.
# Must be identical on gateway and appview.
GATEWAY_APPVIEW_INTERNAL_SECRET=<openssl-rand-hex-32>

# Operations proxy target. Required for the gateway to register and serve
# /v1/operations/* from the independent Operations service.
OPERATIONS_BASE_URL=http://${{Ops.RAILWAY_PRIVATE_DOMAIN}}:${{Ops.PORT}}

# Shared HMAC secret for Gateway -> Operations internal trust.
# Must be identical on gateway and operations.
GATEWAY_OPERATIONS_INTERNAL_SECRET=<openssl-rand-hex-32>

# OAuth metadata origin for the web client. Set to the public API origin that
# hosts /oauth/client-metadata.json.
OAUTH_PUBLIC_ORIGIN=https://api.testing.thesocialwire.app

# Optional explicit CORS allow-list for browser clients. Comma/newline/space
# delimited. If unset, the gateway falls back to OAUTH_PUBLIC_ORIGIN.
CORS_ALLOWED_ORIGINS=https://testing.thesocialwire.app,https://thesocialwire.app

# Optional origin override used only for /ios-client-metadata.json.
# Set when the iOS client metadata is served from a different API host.
OAUTH_IOS_METADATA_ORIGIN=https://api.testing.thesocialwire.app

# Operations SPA callback origin. The Gateway serves public, identity-only
# metadata for the hosted Operations frontend at /operations-oauth-client-metadata.json.
OAUTH_OPERATIONS_ORIGIN=https://operations.testing.thesocialwire.app
OAUTH_OPERATIONS_CLIENT_ID=https://api.testing.thesocialwire.app/operations-oauth-client-metadata.json

# Hosted OAuth policy. Tokens from unknown clients are allowed unless this is true.
OAUTH_GATEWAY_REQUIRE_KNOWN_CLIENT=true

# Comma/newline/space-delimited client IDs accepted when known-client policy is enabled.
OAUTH_GATEWAY_ALLOWED_CLIENT_IDS=https://api.testing.thesocialwire.app/oauth/client-metadata.json,https://api.testing.thesocialwire.app/ios-client-metadata.json,https://api.testing.thesocialwire.app/operations-oauth-client-metadata.json

# Optional comma/newline/space-delimited accepted token audiences.
# Leave empty unless narrowing access-token audiences deliberately.
OAUTH_GATEWAY_ALLOWED_AUDIENCES=

# Optional JWKS JSON used when an OAuth issuer omits signing keys from metadata.
# Usually unset.
OAUTH_ACCESS_TOKEN_SUPPLEMENTAL_JWKS_JSON=

# Optional L@tr Link iOS proxy. When unset, /v1/latr/* routes are not registered.
LATR_IOS_PROXY_URL=https://api.latr.link
LATR_IOS_PROXY_CLIENT_ID=<latr-client-id>
LATR_IOS_PROXY_API_KEY=<latr-api-key>

# Alternative to LATR_IOS_PROXY_CLIENT_ID + LATR_IOS_PROXY_API_KEY for official
# first-party credentials.
LATR_IOS_PROXY_CLIENT_CREDENTIAL=

# SQLite path retained for package/tests and a future restored local mode.
# Current executable startup still requires APP_ENV=dev|prod + DATABASE_URL.
SQLITE_DB_PATH=./social-wire.sqlite
