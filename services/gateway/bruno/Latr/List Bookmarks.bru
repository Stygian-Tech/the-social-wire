meta {
  name: List Bookmarks
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/xrpc/link.latr.bookmarks.listBookmarks?limit=50
  body: none
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
  X-ATProto-Upstream-DPoP: {{upstreamDpopProof}}
}

docs {
  Lists one bookmark page. Repeat with the returned cursor until exhausted.
}
