meta {
  name: Get L@tr OG Preview
  type: http
  seq: 50
}

get {
  url: {{baseUrl}}/v1/latr/og-preview?url=https%3A%2F%2Fexample.com%2Farticle
  body: none
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
}

docs {
  Requests Open Graph preview metadata through the native L@tr proxy. Replace the encoded `url` query value with the target HTTPS article.
}
