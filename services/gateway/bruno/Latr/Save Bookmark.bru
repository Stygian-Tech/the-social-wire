meta {
  name: Save Bookmark
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/xrpc/link.latr.bookmarks.saveBookmark
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
  X-ATProto-Upstream-DPoP: {{upstreamDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "subject": "https://example.com/article"
  }
}
