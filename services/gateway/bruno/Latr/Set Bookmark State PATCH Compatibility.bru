meta {
  name: Set Bookmark State PATCH Compatibility
  type: http
  seq: 41
}

patch {
  url: {{baseUrl}}/xrpc/link.latr.bookmarks.setState
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
  X-ATProto-Upstream-DPoP: {{upstreamDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "bookmarkUri": "{{latrBookmarkUri}}",
    "state": "archived"
  }
}


docs {
  Compatibility route for the deployed L@tr bookmark state handler. Generate both
  gateway-bound DPoP proofs with htm PATCH. PDS proofs retain their own methods.
  The canonical Lexicon POST procedure and existing POST proxy remain unchanged.
}
