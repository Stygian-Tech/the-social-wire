meta {
  name: Rename Bookmark Tag
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/xrpc/link.latr.bookmarks.renameTag
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
  X-ATProto-Upstream-DPoP: {{upstreamDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "tag": "Reading",
    "replacement": "Read Later",
    "limit": 25
  }
}

docs {
  Re-submit with each returned cursor until the global rewrite is complete.
}
