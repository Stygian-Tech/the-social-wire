meta {
  name: Get Bookmark
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/xrpc/link.latr.bookmarks.getBookmark?subject=https%3A%2F%2Fexample.com%2Farticle
  body: none
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  X-Latr-Gateway-DPoP: {{latrGatewayDpopProof}}
  X-ATProto-Upstream-DPoP: {{upstreamDpopProof}}
}

docs {
  Looks up the exact generic bookmark subject.
}
