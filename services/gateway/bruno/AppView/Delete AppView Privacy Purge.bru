meta {
  name: Delete AppView Privacy Purge
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/xrpc/app.thesocialwire.appview.purgeViewerData
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  Content-Type: application/json
}

body:json {
  {}
}

docs {
  Deletes all indexed read marks for the authenticated viewer. Requires `ENABLE_THIN_APPVIEW=true`.
}
