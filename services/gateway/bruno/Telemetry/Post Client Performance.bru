meta {
  name: Post Client Performance
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/telemetry/client-performance
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "event": "cached_feed_paint",
    "durationMs": 82,
    "feedType": "aggregate",
    "cacheState": "hit",
    "outcome": "success",
    "environment": "dev"
  }
}

docs {
  Authenticated, allowlisted reader performance telemetry. Never include identifiers or URLs.
}
