meta {
  name: Post RSS Subscription
  type: http
  seq: 39
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.createRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "app.skyreader.feed.subscription",
    "record": {
      "$type": "app.skyreader.feed.subscription",
      "feedUrl": "{{feedUrl}}",
      "title": "Example Feed",
      "siteUrl": "https://example.com",
      "createdAt": "{{recordCreatedAt}}",
      "updatedAt": "{{recordCreatedAt}}",
      "source": "the-social-wire",
      "sourceType": "rss"
    }
  }
}

docs {
  Creates a Skyreader RSS subscription directly on the viewer PDS with standard XRPC.
  Save the rkey from the returned `uri` as `rssSubscriptionRkey`.
}
