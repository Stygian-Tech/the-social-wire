meta {
  name: Post Graph Subscription
  type: http
  seq: 37
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.createRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "site.standard.graph.subscription",
    "record": {
      "$type": "site.standard.graph.subscription",
      "publication": "{{publicationId}}"
    }
  }
}

docs {
  Creates a graph subscription directly on the viewer PDS with standard XRPC.
  Save the rkey from the returned `uri` as `subscriptionRkey`.
}
