meta {
  name: Delete Graph Subscription
  type: http
  seq: 38
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.deleteRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "site.standard.graph.subscription",
    "rkey": "{{subscriptionRkey}}"
  }
}

docs {
  Deletes a graph subscription directly from the viewer PDS with standard XRPC.
}
