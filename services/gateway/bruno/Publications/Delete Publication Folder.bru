meta {
  name: Delete Publication Folder
  type: http
  seq: 35
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.deleteRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "app.thesocialwire.folder",
    "rkey": "{{folderRkey}}"
  }
}

docs {
  Deletes a folder record directly from the viewer PDS with standard XRPC.
}
