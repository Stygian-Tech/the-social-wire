meta {
  name: Put Publication Prefs
  type: http
  seq: 36
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.putRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "app.thesocialwire.publicationPrefs",
    "rkey": "{{publicationPrefsRkey}}",
    "record": {
      "$type": "app.thesocialwire.publicationPrefs",
      "publicationId": "{{publicationId}}",
      "folderId": "{{folderRkey}}",
      "sortOrder": 0,
      "hidden": false,
      "createdAt": "{{recordCreatedAt}}"
    }
  }
}

docs {
  Upserts `app.thesocialwire.publicationPrefs` directly on the viewer PDS with standard XRPC.
}
