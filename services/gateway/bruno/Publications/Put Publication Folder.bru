meta {
  name: Put Publication Folder
  type: http
  seq: 34
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.putRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "app.thesocialwire.folder",
    "rkey": "{{folderRkey}}",
    "record": {
      "$type": "app.thesocialwire.folder",
      "name": "Renamed Folder",
      "sortOrder": 1,
      "createdAt": "{{recordCreatedAt}}"
    }
  }
}

docs {
  Replaces an existing folder record directly on the viewer PDS with standard XRPC.
}
