meta {
  name: Post Publication Folder
  type: http
  seq: 33
}

post {
  url: {{pdsUrl}}/xrpc/com.atproto.repo.createRecord
  body: json
  auth: none
}

headers {
  Authorization: DPoP {{oauthAccessToken}}
  DPoP: {{pdsDpopProof}}
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{userDid}}",
    "collection": "app.thesocialwire.folder",
    "record": {
      "$type": "app.thesocialwire.folder",
      "name": "Bruno Test Folder",
      "sortOrder": 0,
      "createdAt": "{{recordCreatedAt}}"
    }
  }
}

docs {
  Creates an `app.thesocialwire.folder` record directly on the viewer PDS with standard XRPC.
  Save the rkey from the returned `uri` as `folderRkey`.
}
