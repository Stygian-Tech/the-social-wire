{
  "lexicon": 1,
  "id": "app.thesocialwire.liveEvent",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Public viewer-owned live event. Updates and destination records commit atomically. Never store secrets.",
      "record": {
        "type": "object",
        "required": [
          "title",
          "tags",
          "destination",
          "createdAt",
          "updatedAt",
          "entries"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "tags": {
            "type": "array",
            "maxLength": 20,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "destination": {
            "type": "string",
            "enum": [
              "blog",
              "bluesky",
              "both"
            ]
          },
          "publicationUri": {
            "type": "string",
            "format": "at-uri"
          },
          "articleRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "articleUrl": {
            "type": "string",
            "format": "uri"
          },
          "threadRoot": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "threadLast": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          },
          "entries": {
            "type": "array",
            "maxLength": 500,
            "items": {
              "type": "ref",
              "ref": "#update"
            }
          },
          "sourceEvent": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "startsAt": {
            "type": "string",
            "format": "datetime"
          },
          "endsAt": {
            "type": "string",
            "format": "datetime"
          },
          "endedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the author closed the live post session, independent of its scheduled end."
          }
        }
      }
    },
    "update": {
      "type": "object",
      "required": [
        "id",
        "createdAt",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "text": {
          "type": "string",
          "maxLength": 30000
        },
        "articleRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        },
        "postRef": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        },
        "attachmentsFingerprint": {
          "type": "string",
          "maxLength": 64
        },
        "media": {
          "type": "ref",
          "ref": "#media"
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "images": {
          "type": "array",
          "maxLength": 4,
          "items": {
            "type": "ref",
            "ref": "#image"
          }
        },
        "video": {
          "type": "ref",
          "ref": "#video"
        },
        "gif": {
          "type": "ref",
          "ref": "#gif"
        },
        "external": {
          "type": "ref",
          "ref": "#external"
        },
        "pdsUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "blob",
        "alt"
      ],
      "properties": {
        "blob": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "maxSize": 2000000
        },
        "alt": {
          "type": "string",
          "maxLength": 10000
        },
        "aspectRatio": {
          "type": "ref",
          "ref": "#aspectRatio"
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "blob",
        "alt"
      ],
      "properties": {
        "blob": {
          "type": "blob",
          "accept": [
            "video/mp4"
          ],
          "maxSize": 100000000
        },
        "alt": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "gif": {
      "type": "object",
      "required": [
        "url",
        "alt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "alt": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "external": {
      "type": "object",
      "required": [
        "external"
      ],
      "properties": {
        "external": {
          "type": "object",
          "required": [
            "uri",
            "title",
            "description"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "title": {
              "type": "string",
              "maxLength": 3000
            },
            "description": {
              "type": "string",
              "maxLength": 10000
            },
            "thumb": {
              "type": "blob",
              "accept": [
                "image/*"
              ],
              "maxSize": 1000000
            }
          }
        }
      }
    },
    "aspectRatio": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
