{
  "lexicon": 1,
  "id": "app.thesocialwire.discovery.getWireEdition",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the generation-bound editorial edition of The Wire.",
      "parameters": {
        "type": "params",
        "properties": {
          "lang": { "type": "string", "maxLength": 35 },
          "region": { "type": "string", "knownValues": ["outside-us"] }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "app.thesocialwire.discovery.defs#wireEdition" }
      },
      "errors": [{"name":"UpstreamProofRequired","description":"Authenticated viewer cache is unavailable; prepare the route upstream proof pool and retry once."},
        { "name": "InvalidRequest" },
        { "name": "ModerationUnavailable" },
        { "name": "RateLimitExceeded" },
        { "name": "FeedUnavailable" }
      ]
    }
  }
}
