{
  "lexicon": 1,
  "id": "app.thesocialwire.readState",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Public canonical read/unread manifest. V1 uses head; V2 requires revision and compactionVersion=1 with separate state/device/legacy-receipt roots. Every root must be fully CID-verified before atomic activation. Maintenance revisions never invent user-action sequences.",
      "record": {
        "type": "object",
        "required": [
          "version",
          "generation",
          "lastSequence"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "generation": {
            "type": "string",
            "maxLength": 128
          },
          "lastSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "head": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "compactionVersion": {
            "type": "integer",
            "const": 1
          },
          "stateHead": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "devicesHead": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "legacyReceiptsHead": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}
