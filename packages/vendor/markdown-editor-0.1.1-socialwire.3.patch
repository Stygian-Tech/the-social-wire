+export function markdownCodeText(source: string): string {
+  const lines = source.replace(/\r\n?/g, "\n").split("\n");
+  const fence = /^ {0,3}(`{3,}|~{3,})/.exec(lines[0] ?? "")?.[1];
+  if (!fence) return source;
+  lines.shift();
+  if (lines.length && new RegExp(`^ {0,3}${fence[0]}{${fence.length},}[ \\t]*$`).test(lines.at(-1)!)) lines.pop();
+  return lines.join("\n");
