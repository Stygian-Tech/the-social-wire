+/** Display helpers derive text without rewriting the retained Markdown source. */
+export function markdownHeadingText(source: string): string {
+  const lines = source.replace(/\r\n?/g, "\n").trim().split("\n");
+  if (lines.length > 1 && /^ {0,3}(?:=+|-+)[ \t]*$/.test(lines.at(-1)!)) return lines.slice(0, -1).join("\n");
